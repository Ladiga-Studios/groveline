NEXT_PUBLIC_SITE_URL=https://groveline.io
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
RESEND_API_KEY=your-resend-key
RESEND_FROM="Groveline <hello@send.groveline.io>"

# Optional. Leave both blank and the site works fine, just without the
# bot-check widget on the reservation form. Get free keys from the
# Cloudflare dashboard under Turnstile (same account as your DNS).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe. Card payments to sellers (Connect) and the $10/month subscription.
# Leave blank and the site runs cash-only with no subscription gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Second signing secret, from the "connected accounts" event destination.
STRIPE_WEBHOOK_SECRET_CONNECT=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# express (easier seller signup, Stripe bills you ~$2/active account/month)
# or standard (longer seller signup, no monthly fee to you)
STRIPE_CONNECT_TYPE=express
# A code that gives first-time subscribers a 30-day free trial on either plan.
FREE_MONTH_CODE=LADIGA

# Where listing reports and support messages get emailed. Optional.
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Protects the daily cron route. Vercel sends it automatically once set.
CRON_SECRET=
